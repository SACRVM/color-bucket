{
  // Firepit per-project config. JSONC: comments and trailing commas are allowed.
  // Commands follow the Linux patterns of ../firepit-template/.firepit/config.json:
  // a group per area, a short lowercase name, a one-line description.

  "version": 1,
  "id": "color-bucket",

  "commands": [
    {
      "group": "Run",
      "name": "site",
      "description": "Serves the app on port 3100 (also reachable from a phone on the LAN).",
      "type": "shell",
      "command": "python3",
      "args": ["-m", "http.server", "3100"],
      "window": "reuse:site",
      "longRunning": true
    },

    {
      "group": "Test",
      "name": "all",
      "description": "Runs the engine, spectral.js and harmony tests; the result comes back in the chat.",
      "type": "shell",
      "command": "npm",
      "args": ["test"],
      "window": "inline"
    },

    {
      "group": "Open",
      "name": "app",
      "description": "The app on the local server.",
      "type": "url",
      "url": "http://localhost:3100/"
    },
    {
      "group": "Open",
      "name": "harmony",
      "description": "A three-pigment recipe on the local server, with its harmony palette open.",
      "type": "url",
      "url": "http://localhost:3100/#/F2C500x2,D93A2Bx1,1F3A93x1;pigment;oils"
    },

    {
      "group": "Git",
      "name": "repo",
      "description": "The repository on GitHub.",
      "type": "url",
      "url": "https://github.com/SACRVM/color-bucket"
    }
  ]
}
