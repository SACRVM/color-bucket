# Dependencies — restore with `npm install`
node_modules/

# Local tool state (project-wide settings in .claude/settings.json are tracked)
.claude/settings.local.json

# The Firepit block below is the live rule; there is no blanket .firepit/ line.
# There was one once, with a comment insisting it stay — it was dropped when the
# blueprint was brought up to date, because it hid the shared project config
# that is meant to be versioned. The comment outlived the line and said the
# opposite of what the file did for two commits; this replaces it.
# What ships: .firepit/config.json (the toolbar buttons) and the pointer file
# .firepit/knowledge; the knowledge documents live outside this repo. What does
# not: the inbox, run logs, the derived search index and the pinned digest
# compiled from those documents (excluded in .git/info/exclude).

# OS / editor cruft
Thumbs.db
desktop.ini
.DS_Store
*.stackdump

# Firepit + Claude Code — shared config versioned, runtime/personal local
.firepit/inbox/
.firepit/runs/
.firepit/knowledge.db*
!.firepit/config.json
.claude/*.lock
.claude/agent-memory/

# Local MCP config (Firepit): per machine, not project material.
# Commit it only if a server in it is needed to run this repo.
.mcp.json
